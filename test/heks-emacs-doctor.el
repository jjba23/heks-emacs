;;; heks-emacs-doctor.el --- The doctor's table, written into the manual -*- lexical-binding: t -*-

;; SPDX-License-Identifier: MIT
;; Copyright © Josep Bigorra <jjbigorra@gmail.com>

;;; Commentary:

;; `heks/doctor' (`C-c ! d') lists the external programs this configuration
;; expects, the version each answers with, and what its module does without
;; it.  `heks/doctor-programs' is that knowledge as data, in
;; `modules/dev-tools.el'.  This is the same table as a document: written
;; into `docs/installation.org', the page a person reads before installing
;; on a new machine, and checked the way `docs/keybindings.org' is -- the
;; task fails while the file and the table disagree, so a module cannot
;; start needing a program without the manual saying so.
;;
;; The table is written between two markers rather than the whole file
;; being generated: the rest of the page is prose, and only this part is a
;; rendering of something that already exists as data.
;;
;;   emacs -Q --batch -l test/heks-emacs-doctor.el
;;   HEKS_DOCTOR_WRITE=1 emacs -Q --batch -l test/heks-emacs-doctor.el
;;
;; The second form writes the table; the first fails when the file has
;; stopped saying what the modules expect.  `maak doctor' and `maak
;; doctor-update' are the two.

;;; Code:

(setq load-prefer-newer t)
(require 'cl-lib)
(require 'seq)
(require 'subr-x)

(defconst heks-doctor--root
  (file-name-as-directory
   (or (getenv "HEKS_DOCTOR_SOURCE")
       (expand-file-name ".." (file-name-directory (file-truename load-file-name)))))
  "The checkout holding the configuration and the manual.")

(defconst heks-doctor--reference "docs/installation.org"
  "The page whose requirements table is written from `heks/doctor-programs'.")

(defconst heks-doctor--begin "# BEGIN heks-doctor (generated by `maak doctor-update')"
  "The line the generated table starts after.")

(defconst heks-doctor--end "# END heks-doctor"
  "The line the generated table ends before.")

(defmacro use-package (&rest _)
  "Stand in for the macro that installs packages, which is not under test."
  nil)

(defun heks-doctor--module (name)
  "Load the module NAME from the source tree and return its feature."
  (load (expand-file-name (format "modules/%s.el" name)
                          (expand-file-name "src" heks-doctor--root))
        nil t))

;; `heks-emacs.el` declares the group the others customize, and the doctor
;; itself -- with its table -- is in `dev-tools.el`.
(dolist (module '("heks-emacs" "emacs-core" "dev-tools"))
  (heks-doctor--module module))

(defvar heks-doctor--failures 0)

(defun heks-doctor--cell (text)
  "Return TEXT as one table cell, with the pipe it would break escaped."
  (replace-regexp-in-string "|" "\\\\vert{}"
                            (or text "")))

(defun heks-doctor--table ()
  "Return `heks/doctor-programs' as the Org table the manual shows.

One row per program, in the order the doctor reports them: what the
program is, the module that wants it, and what that module does without
it -- the same three things `C-c ! d' prints, so the page and the report
cannot say different things."
  (let ((header "| Program | Wanted by | Without it |")
        (rule "|---------+-----------+------------|")
        (rows '()))
    (dolist (entry heks/doctor-programs)
      (push (format "| ~%s~ | %s | %s |"
                    (heks-doctor--cell (car entry))
                    (heks-doctor--cell (cadr entry))
                    (heks-doctor--cell (cddr entry)))
            rows))
    (concat (string-join (append (list header rule) (nreverse rows)) "\n") "\n")))

(defun heks-doctor--document ()
  "Return the table as the manual should hold it, markers and all."
  (concat heks-doctor--begin "\n" (heks-doctor--table) heks-doctor--end "\n"))

(defun heks-doctor--find (text)
  "Return the generated region of TEXT as (START . END), or nil."
  (let ((start (string-match (concat "^" (regexp-quote heks-doctor--begin) "$") text)))
    (when start
      (let ((end (string-match (concat "^" (regexp-quote heks-doctor--end) "$")
                               text (match-end 0))))
        (and end (cons start (+ (match-end 0) 1)))))))

(defun heks-doctor--diff (actual expected)
  "Describe how the table in the manual differs from ACTUAL EXPECTED."
  (let ((position 0)
        (line 0)
        (shown 0))
    (while (and (< position (min (length expected) (length actual)))
                (equal (aref actual position) (aref expected position)))
      (when (eq (aref actual position) ?\n) (setq line (1+ line)))
      (setq position (1+ position)))
    (when (< position (length expected))
      (let ((mine (string-trim (substring expected position
                                          (or (string-match "\n" expected position)
                                              (length expected)))))
            (theirs (string-trim (substring actual position
                                            (or (string-match "\n" actual position)
                                                (length actual))))))
        (format "the first line that differs is at line %d:\n       file: %s\n       now:  %s"
                (+ line 1) mine theirs)))))

(defun heks-doctor--check ()
  "Write the table into the manual, or fail while they disagree."
  (let ((file (expand-file-name heks-doctor--reference heks-doctor--root))
        (table (heks-doctor--document)))
    (if (getenv "HEKS_DOCTOR_WRITE")
        (progn
          (with-temp-buffer
            (insert-file-contents file)
            (goto-char (point-min))
            (if (search-forward heks-doctor--begin nil t)
                (progn
                  (beginning-of-line)
                  (let ((start (point)))
                    (unless (search-forward heks-doctor--end nil t)
                      (error "%s: the table starts and does not end" heks-doctor--reference))
                    (delete-region start (point))
                    (goto-char start)
                    (insert (string-remove-suffix "\n" table))))
              (error "%s: the markers of the generated table are gone; add %S and %S where the table goes"
                     heks-doctor--reference heks-doctor--begin heks-doctor--end))
            (let ((text (buffer-string)))
              (with-temp-file file (insert text))))
          (message "\n== wrote the doctor's table into %s ==" heks-doctor--reference))
      (message "\n== the doctor's table, in %s ==" heks-doctor--reference)
      (let* ((text (if (file-exists-p file)
                       (with-temp-buffer
                         (insert-file-contents file)
                         (buffer-string))
                     ""))
             (region (heks-doctor--find text)))
        (cond
         ((null region)
          (setq heks-doctor--failures (1+ heks-doctor--failures))
          (message "  FAIL there is no generated table in it; write it with\n        HEKS_DOCTOR_WRITE=1 emacs -Q --batch -l test/heks-emacs-doctor.el"))
         ((equal (substring text (car region) (cdr region)) table)
          (message "  ok   it says what the modules expect: %d programs"
                   (length heks/doctor-programs)))
         (t
          (setq heks-doctor--failures (1+ heks-doctor--failures))
          (message "  FAIL it does not; write it with\n        HEKS_DOCTOR_WRITE=1 emacs -Q --batch -l test/heks-emacs-doctor.el")
          (let ((difference (heks-doctor--diff (substring text (car region) (cdr region))
                                               table)))
            (when difference (message "       %s" difference)))))))))

;; The table is data in `dev-tools.el', so it can be read without loading
;; the installed configuration; a program named twice would be a report
;; with two rows that say different things about it.
(message "== the doctor's list ==")
(let ((seen '()))
  (dolist (entry heks/doctor-programs)
    (if (member (car entry) seen)
        (progn
          (setq heks-doctor--failures (1+ heks-doctor--failures))
          (message "  FAIL %s is listed twice" (car entry)))
      (push (car entry) seen)))
  (unless (zerop (length seen))
    (message "  ok   %d programs, each listed once" (length seen))))

(heks-doctor--check)

(message "\n== %d failures ==" heks-doctor--failures)
(when (> heks-doctor--failures 0)
  (kill-emacs 1))

;;; heks-emacs-doctor.el ends here
