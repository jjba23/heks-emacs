;;; heks-emacs-modules.el --- Check the module declarations against the modules  -*- lexical-binding: t -*-

;; SPDX-License-Identifier: MIT
;; Copyright © Josep Bigorra <jjbigorra@gmail.com>

;;; Commentary:

;; The key scheme has always implied a rule it could not state: the module
;; owns its topic, so a key about notes goes in `notes.el'.  The keys were
;; checked and the rule was prose.  `heks/module-declarations' (in
;; `heks-emacs.el') states it as data -- each module's one-sentence purpose
;; and the topic letters whose keys may be bound in it -- and this reads
;; it, three ways:
;;
;;   * the files and the declarations agree, in both directions: a module
;;     with no declaration is a module nobody wrote down, and a declaration
;;     with no module is a page about a file that is gone;
;;   * every key the configuration binds is under a topic its own module
;;     declared, which is the rule itself, read off the source with the
;;     reader `test/heks-emacs-keys.el' already has;
;;   * every topic in `heks/key-topics' has an owner, so a topic cannot
;;     describe a letter that no module is responsible for.
;;
;; `docs/modules.org' carries the same table, written by `maak
;; modules-update' from the declarations and checked while the two
;; disagree -- the same discipline as `docs/keybindings.org', applied to
;; what is above the keys.
;;
;;   emacs -Q --batch -l test/heks-emacs-modules.el
;;   HEKS_MODULES_WRITE=1 emacs -Q --batch -l test/heks-emacs-modules.el
;;
;; The key reader is loaded with `HEKS_KEYS_NO_RUN' set, so this reads the
;; bindings without auditing them twice: `maak keys' already owns that.

;;; Code:

(setq load-prefer-newer t)
(require 'cl-lib)
(require 'seq)
(require 'subr-x)

(defconst heks-modules--root
  (file-name-as-directory
   (or (getenv "HEKS_MODULES_SOURCE")
       (expand-file-name ".." (file-name-directory (file-truename load-file-name)))))
  "The checkout holding the modules and the page about them.")

(defconst heks-modules--reference "docs/modules.org"
  "The page that carries the table of modules.")

(defconst heks-modules--begin "# BEGIN heks-modules (generated by `maak modules-update')"
  "The line the generated table starts after.")

(defconst heks-modules--end "# END heks-modules"
  "The line the generated table ends before.")

(defmacro use-package (&rest _)
  "Stand in for the macro that installs packages, which is not under test."
  nil)

(defun heks-modules--module (name)
  "Load the module NAME from the source tree and return its feature."
  (load (expand-file-name (format "modules/%s.el" name)
                          (expand-file-name "src" heks-modules--root))
        nil t))

;; The declarations are in `heks-emacs.el', the topic letters the check is
;; held to are in `emacs-core.el', and the bindings come from the key
;; audit's own reader rather than a second one.
(dolist (module '("heks-emacs" "emacs-core"))
  (heks-modules--module module))

(setenv "HEKS_KEYS_NO_RUN" "1")
(setenv "HEKS_KEYS_SOURCE" heks-modules--root)
(load (expand-file-name "test/heks-emacs-keys.el" heks-modules--root) nil t)
(setq default-directory heks-modules--root)
(heks-keys--read-source)

(defvar heks-modules--failures 0)

(defun heks-modules--check (label value &optional expected)
  "Record that LABEL holds when VALUE equals EXPECTED, which defaults to t."
  (if (equal value (if (or (null expected) (eq expected t)) t expected))
      (message "  ok   %s" label)
    (setq heks-modules--failures (1+ heks-modules--failures))
    (message "  FAIL %s -> %S" label value)))

(defun heks-modules--files ()
  "Return the module files in the checkout, as the symbols they are declared by."
  (mapcar (lambda (file) (intern (file-name-base file)))
          (directory-files (expand-file-name "src/modules" heks-modules--root)
                           nil "\\`[^.#].*\\.el\\'")))

(defun heks-modules--declared ()
  "Return the modules the declarations name, in order."
  (mapcar (lambda (declaration) (plist-get declaration :module))
          heks/module-declarations))

(defun heks-modules--topics-of (module)
  "Return the topics MODULE declared."
  (plist-get (seq-find (lambda (declaration)
                         (eq (plist-get declaration :module) module))
                       heks/module-declarations)
             :topics))

;;
;; The checks.
;;

(message "== every module is declared, and every declaration is a module ==")
(let ((files (heks-modules--files))
      (declared (heks-modules--declared)))
  (dolist (file files)
    (heks-modules--check (format "modules/%s.el is declared" file)
                         (and (memq file declared) t)))
  (dolist (module declared)
    (heks-modules--check (format "modules/%s.el exists" module)
                         (and (memq module files) t)))
  (heks-modules--check "no module is declared twice"
                       (= (length declared) (length (delete-dups declared))))
  (heks-modules--check "every declaration has a purpose"
                       (seq-every-p (lambda (declaration)
                                      (let ((purpose (plist-get declaration :purpose)))
                                        (and (stringp purpose)
                                             (string-suffix-p "." purpose)
                                             (> (length purpose) 4))))
                                    heks/module-declarations))
  (heks-modules--check "every declaration says what it may bind"
                       (seq-every-p (lambda (declaration)
                                      (listp (plist-get declaration :topics)))
                                    heks/module-declarations))
  (message "  (%d modules, %d declarations)" (length files) (length declared)))

(message "\n== no key is bound outside a topic its module declared ==")
(let ((loose 0))
  (dolist (entry (reverse heks-keys--entries))
    (let* ((key (car entry))
           (file (intern (file-name-base (nth 3 entry))))
           (topic (heks-keys--top key))
           (declared (heks-modules--topics-of file)))
      (when (and topic (not (member topic declared)))
        (setq loose (1+ loose))
        (setq heks-modules--failures (1+ heks-modules--failures))
        (message "  FAIL %-12s is bound in %s, which did not declare topic `%s'"
                 key (nth 3 entry) topic))))
  (when (zerop loose)
    (message "  none: %d keys, each under a topic its own module declared"
             (length heks-keys--entries))))

(message "\n== every topic has a module to answer for it ==")
(let ((unowned 0))
  (dolist (topic heks/key-topics)
    (let ((owners (seq-filter (lambda (declaration)
                                (member (car topic) (plist-get declaration :topics)))
                              heks/module-declarations)))
      (cond ((null owners)
             (setq unowned (1+ unowned)
                   heks-modules--failures (1+ heks-modules--failures))
             (message "  FAIL C-c %s is described and no module owns it" (car topic)))
            ((not (seq-some (lambda (owner)
                              (let ((module (plist-get owner :module)))
                                (seq-some (lambda (entry)
                                            (and (eq (intern (file-name-base (nth 3 entry)))
                                                     module)
                                                 (equal (heks-keys--top (car entry))
                                                        (car topic))))
                                          heks-keys--entries)))
                            owners))
             (setq heks-modules--failures (1+ heks-modules--failures))
             (message "  FAIL C-c %s is owned by %s, which binds no key under it"
                      (car topic)
                      (string-join (mapcar (lambda (owner)
                                             (symbol-name (plist-get owner :module)))
                                           owners) ", "))))))
  (when (zerop unowned)
    (message "  none: %d topics, each with an owner that binds a key under it"
             (length heks/key-topics))))

;;
;; The table, for the page that is about the modules.
;;

(defun heks-modules--table ()
  "Return the declarations as the Org table `docs/modules.org' shows."
  (let ((header "| Module | What it is | The keys it owns |")
        (rule "|--------+------------+------------------|")
        (rows '()))
    (dolist (declaration heks/module-declarations)
      (let ((topics (plist-get declaration :topics)))
        (push (format "| =%s.el= | %s | %s |"
                      (plist-get declaration :module)
                      (replace-regexp-in-string "|" "\\\\vert{}"
                                                (plist-get declaration :purpose))
                      (if topics
                          (mapconcat (lambda (topic) (format "~%s~" topic)) topics ", ")
                        "--"))
              rows)))
    (concat (string-join (append (list header rule) (nreverse rows)) "\n") "\n")))

(defun heks-modules--document ()
  "Return the table as the page should hold it, markers and all."
  (concat heks-modules--begin "\n" (heks-modules--table) heks-modules--end "\n"))

(defun heks-modules--find (text)
  "Return the generated region of TEXT as (START . END), or nil."
  (let ((start (string-match (concat "^" (regexp-quote heks-modules--begin) "$") text)))
    (when start
      (let ((end (string-match (concat "^" (regexp-quote heks-modules--end) "$")
                               text (match-end 0))))
        (and end (cons start (+ (match-end 0) 1)))))))

(defun heks-modules--check-reference ()
  "Write the table into the page, or fail while they disagree."
  (let ((file (expand-file-name heks-modules--reference heks-modules--root))
        (table (heks-modules--document)))
    (if (getenv "HEKS_MODULES_WRITE")
        (progn
          (with-temp-buffer
            (insert-file-contents file)
            (goto-char (point-min))
            (if (search-forward heks-modules--begin nil t)
                (progn
                  (beginning-of-line)
                  (let ((start (point)))
                    (unless (search-forward heks-modules--end nil t)
                      (error "%s: the table starts and does not end"
                             heks-modules--reference))
                    (delete-region start (point))
                    (goto-char start)
                    (insert (string-remove-suffix "\n" table))))
              (error "%s: the markers of the generated table are gone; add %S and %S where the table goes"
                     heks-modules--reference heks-modules--begin heks-modules--end))
            (let ((text (buffer-string)))
              (with-temp-file file (insert text))))
          (message "\n== wrote the table into %s ==" heks-modules--reference))
      (message "\n== the table of modules, in %s ==" heks-modules--reference)
      (let* ((text (if (file-exists-p file)
                       (with-temp-buffer
                         (insert-file-contents file)
                         (buffer-string))
                     ""))
             (region (heks-modules--find text)))
        (cond
         ((null region)
          (setq heks-modules--failures (1+ heks-modules--failures))
          (message "  FAIL there is no generated table in it; write it with\n        HEKS_MODULES_WRITE=1 emacs -Q --batch -l test/heks-emacs-modules.el"))
         ((equal (substring text (car region) (cdr region)) table)
          (message "  ok   it says what the declarations say: %d modules"
                   (length heks/module-declarations)))
         (t
          (setq heks-modules--failures (1+ heks-modules--failures))
          (message "  FAIL it does not; write it with\n        HEKS_MODULES_WRITE=1 emacs -Q --batch -l test/heks-emacs-modules.el")))))))

(heks-modules--check-reference)

(message "\n== %d failures ==" heks-modules--failures)
(when (> heks-modules--failures 0)
  (kill-emacs 1))

;;; heks-emacs-modules.el ends here
